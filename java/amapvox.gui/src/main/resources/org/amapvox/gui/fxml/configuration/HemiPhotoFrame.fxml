<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane  id="AnchorPane" minHeight="0.0" minWidth="0.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.amapvox.gui.configuration.HemiPhotoFrameController">
    <children>
        <ScrollPane fitToWidth="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox>
                    <children>
                        <fx:include fx:id="canopyToolsIOFrame" source="../CanopyToolsIOFrame.fxml" />   
                        <fx:include fx:id="sensorPositions" source="../SensorPositions.fxml" /> 
                        <TitledPane animated="false" expanded="true" text="Hemispherical photograph parameters">
                            <content>
                                <VBox spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                                            <children>
                                                <Label text="Number of pixels"  />
                                                <TextField fx:id="textfieldPixelCount" prefHeight="26.0" prefWidth="74.0" text="800"  />
                                                <fx:include fx:id="buttonHelpPixelCount" source="../HelpButton.fxml"  />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                                            <children>
                                                <Label text="Number of meridians" />
                                                <TextField fx:id="textfieldMeridianCount" prefHeight="26.0" prefWidth="74.0" text="36"  />
                                                <fx:include fx:id="buttonHelpMeridianCount" source="../HelpButton.fxml"  />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                                            <children>
                                                <Label text="Number of parallels"  />
                                                <TextField fx:id="textfieldParallelCount" prefHeight="26.0" prefWidth="74.0" text="9"  />
                                                <fx:include fx:id="buttonHelpParallelCount" source="../HelpButton.fxml" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
