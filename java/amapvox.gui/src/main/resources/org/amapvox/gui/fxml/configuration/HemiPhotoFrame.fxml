<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.amapvox.commons.javafx.SelectableMenuButton?>

<AnchorPane  id="AnchorPane" minHeight="0.0" minWidth="0.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.amapvox.gui.configuration.HemiPhotoFrameController">
    <children>
        <ScrollPane fitToWidth="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox>
                    <children>
                        <TitledPane animated="false" expanded="true" text="Voxel Space">
                            <content>
                                <AnchorPane>
                                    <children>
                                        <VBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0">
                                            <children>
                                                <fx:include fx:id="voxelFileCanopy" source="../VoxelFileCanopy.fxml" />   
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </TitledPane>
                        <TitledPane animated="false" expanded="true" text="Camera positions">
                            <content>
                                <AnchorPane>
                                    <children>
                                        <VBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0">
                                            <children>
                                                <fx:include fx:id="sensorPositions" source="../SensorPositions.fxml" /> 
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </TitledPane>
                        <TitledPane animated="false" expanded="true" text="Hemispherical photographs">
                            <content>
                                <AnchorPane>
                                    <children>
                                        <VBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0">
                                            <children>
                                                <HBox spacing="5.0" alignment="CENTER_LEFT" >
                                                    <children>
                                                        <Label text="Output directory" prefWidth="120.0" />
                                                        <TextField fx:id="textfieldHemiPhotoOutputDirectory" prefHeight="26.0" HBox.hgrow="ALWAYS" />
                                                        <Button maxWidth="-Infinity" mnemonicParsing="false" onAction="#onActionButtonOpenHemiPhotoOutputDirectory" text="..." />
                                                    </children>
                                                </HBox>
                                                <GridPane vgap="5.0" hgap="5.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="120.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="150.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="25.0" minWidth="10.0" prefWidth="25.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                                    </rowConstraints>
                                                    <children>
                                                        <Label GridPane.rowIndex="0" GridPane.columnIndex="0" text="Output file prefix" />
                                                        <TextField GridPane.rowIndex="0" GridPane.columnIndex="1" fx:id="textfieldHemiPhotoOutputPrefix" prefHeight="26.0" prefWidth="150.0" HBox.hgrow="NEVER" />
                                                        <fx:include GridPane.rowIndex="0" GridPane.columnIndex="2" fx:id="buttonHelpOutputPrefix" source="../HelpButton.fxml"  />
                                                        <Label GridPane.rowIndex="1" GridPane.columnIndex="0" text="Pixel number"  />
                                                        <TextField GridPane.rowIndex="1" GridPane.columnIndex="1" fx:id="textfieldPixelNumber" prefHeight="26.0" prefWidth="74.0" text="800"  />
                                                        <fx:include GridPane.rowIndex="1" GridPane.columnIndex="2" fx:id="buttonHelpPixelNumber" source="../HelpButton.fxml"  />
                                                        <Label GridPane.rowIndex="2" GridPane.columnIndex="0" text="Meridian number" />
                                                        <TextField GridPane.rowIndex="2" GridPane.columnIndex="1" fx:id="textfieldMeridianNumber" prefHeight="26.0" prefWidth="74.0" text="36"  />
                                                        <fx:include GridPane.rowIndex="2" GridPane.columnIndex="2" fx:id="buttonHelpMeridianNumber" source="../HelpButton.fxml"  />
                                                        <Label GridPane.rowIndex="3" GridPane.columnIndex="0" text="Parallel number"  />
                                                        <TextField GridPane.rowIndex="3" GridPane.columnIndex="1" fx:id="textfieldParallelNumber" prefHeight="26.0" prefWidth="74.0" text="9"  />
                                                        <fx:include GridPane.rowIndex="3" GridPane.columnIndex="2" fx:id="buttonHelpParallelNumber" source="../HelpButton.fxml" />
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </TitledPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
